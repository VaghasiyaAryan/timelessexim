{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "vercel-out",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/admin/:path*", "destination": "/admin" }
  ]
}
