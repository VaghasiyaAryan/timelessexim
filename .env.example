# Copy to .env and adjust.

# Port for the API / production server (Vite dev server proxies /api here)
PORT=5175

# First admin account — created on first start if no admin exists yet.
# If ADMIN_PASSWORD is left empty, a random password is generated and printed once in the server log.
ADMIN_EMAIL=admin@timelessexim.com
ADMIN_PASSWORD=

# SQLite database file (relative to the project root) — used when TURSO_DATABASE_URL is not set
DATABASE_FILE=data/timeless-exim.db

# Hosted Turso database (required on Vercel, whose filesystem is not persistent).
# Leave empty locally to use DATABASE_FILE instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Set to "production" when deploying behind HTTPS (enables secure cookies)
NODE_ENV=development
